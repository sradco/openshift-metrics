# RHOBS Telemeter client credentials (never commit real values).
# Request a service account via #rhobs-support on Slack.
CLIENTID=
CLIENTSECRET=

# Required for live Telemeter queries (trailing slash required).
# Get the API base URL from #rhobs-support / your RHOBS onboarding docs.
# Do not commit real endpoints to git.
PROM_URL=

# Optional: disable TLS verification (default is verify on). Prefer leaving unset.
# TELEMETER_DISABLE_SSL=1

# Telemeter PromQL guardrails (adapted from rhobs/obs-mcp).
# Default: all static checks + rate-limit (require-non-name-matcher off).
# TELEMETER_GUARDRAILS=all
# TELEMETER_GUARDRAILS=none
# TELEMETER_GUARDRAILS=disallow-blanket-regex,rate-limit
# Optional obs-mcp-style strictness (breaks fleet sum() recipes):
# TELEMETER_GUARDRAILS=disallow-blanket-regex,disallow-unrestricted-selectors,rate-limit,require-non-name-matcher
# TELEMETER_GUARDRAIL_MAX_QUERIES=30
# TELEMETER_GUARDRAIL_WINDOW_SECONDS=600
# TELEMETER_GUARDRAIL_MAX_RANGE_HOURS=48
# Optional: HTTP MCP (streamable-http / container only).
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
# Required for HTTP MCP (Authorization: Bearer …; at least 16 characters).
# MCP_HTTP_TOKEN=
